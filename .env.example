# Supabase → Project Settings → Database
# Connection pooling (Transaction pooler, puerto 6543) — la usa la app en runtime.
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"
# Conexión directa (puerto 5432) — la usa solo `prisma migrate`.
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# Hash bcrypt de tu contraseña de acceso, codificado en base64 (el hash trae
# `$` que los parsers de .env — incluido el de Next.js — pueden corromper si
# se guarda tal cual). Generarlo con:
#   node -e "console.log(Buffer.from(require('bcryptjs').hashSync('TU_CONTRASEÑA', 10)).toString('base64'))"
APP_PASSWORD_HASH_B64=""

# String aleatorio de al menos 32 caracteres para firmar la cookie de sesión.
# Generarlo con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""
